    "long_press_details_ms": 350,
    "detail_panel_max_fraction_of_viewport": 0.3,
    "detail_panel_pauses_pvp": false,
    "gesture": "Hold left Attack + swipe right action area; Hold left Dash + direction swipe. Preserve pointer ownership and cancellation handling.",
    "simultaneous_modifiers": "First held modifier owns that gesture until release/cancel; another press cannot reinterpret it.",
    "facing_and_targeting": "Camera orbit never silently rotates attack-facing. Initial target must satisfy server facing/range/team/context checks; no target snap.",
    "targeted_skill_choice": "Use existing explicit valid-target selection if present; otherwise highlight the eligible entity nearest the body-facing ray within the permitted cone, stable entity-ID tie break. Release does not retarget automatically.",
    "friendly_target_confirmation": "A deliberate ally selection plus a normal attack gesture is required for an ally-targeted Discord Mark; do not choose an ally as a fallback.",
    "new_equipment_policy_dev": "Changing the equipped set occurs at practice reset or outside active rounds; selecting among equipped moves is always available subject to action state. Final live-loadout policy stays open.",
    "accessibility": "Keep keyboard and visible on-screen equivalents. Camera must have an alternative to right-click."
  },
  "timing_and_effects": {
    "clock": "Authoritative simulation time for all gameplay effects; OD-29 deadline clock remains separate.",
    "startup_cap_seconds": 3,
