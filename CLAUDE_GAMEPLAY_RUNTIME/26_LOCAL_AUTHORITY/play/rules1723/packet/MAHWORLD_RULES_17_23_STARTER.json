  "damage": {
    "formula": "raw_budget * potency_index[category] / 100 * periodic_multiplier_if_periodic * existing_applicable_form_and_skill_modifiers, then split into physical/magical components, then guard and resistance per component",
    "apply_each_factor_once": true,
    "periodic_budget_is_total_per_target_over_full_duration": true,
    "periodic_damage_has_no_extra_duration_multiplier": true,
    "rounding": "Keep authoritative existing precision; do not round each intermediate factor.",
    "default_component_weights": {
      "PHYSICAL": {
        "physical": 1,
        "magical": 0
      },
      "PHYSICAL_MAGIC": {
        "physical": 0.6,
        "magical": 0.4
      },
      "SPECIAL_MAGIC": {
        "physical": 0,
        "magical": 1
      }
    },
    "healing": "base_heal * SPECIAL_MAGIC potency / 100, capped at missing HP; never passed through damage resistance",
    "utility": "Use explicit duration/magnitude fields. Do not multiply slows, invisibility, immunity, or movement buffs by damage potency.",
    "long_range_magic": "Skill-specific range/close-effectiveness only. Do not infer universal distance amplification or automatic melee/ranged conversion."
  },
  "resources": {
    "PHYSICAL_cost_pool": null,
