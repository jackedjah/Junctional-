    "combat_regen_delay_after_spend_seconds": 2,
    "combat_regen_conditions": "Alive, simulated time advancing, not casting/channeling or holding either guard; delay measured from the latest committed spend.",
    "flight_regen_and_drain": "Preserve existing implementation; capacity multiplier only.",
    "form_cost": "Preserve existing development pool/cost and MIN_DWELL. This packet does not settle the earlier 5\u201310% reference-attack ambiguity.",
    "startup_reservation": "Reserve full cost at accepted start; reservation is unavailable for other actions.",
    "precommit_interrupt_consumed_fraction": 0.25,
    "commit_cost_fraction": 1,
    "precommit_interrupt_cooldown": "max(0.5 seconds, 0.25 * skill cooldown)",
    "normal_cooldown_starts_at": "COMMIT",
    "invalid_command_cost": 0,
    "duplicate_command_additional_cost": 0,
    "user_cancel_to_refund": false
  },
