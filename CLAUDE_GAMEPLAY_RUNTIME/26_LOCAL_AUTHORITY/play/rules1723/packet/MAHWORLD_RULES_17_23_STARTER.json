    "lowering_control": "Automatic; preserve existing eccentric effects. Uncommitted future effects stop on a valid interrupt; committed effects are not undone.",
    "ordinary_damage_always_interrupts": false,
    "valid_interrupts": "Existing authoritative stagger/stun/knockout/cancel-by-rules events, respecting current poise checks.",
    "channel_on_interrupt": "Stop future ticks; retain committed ticks and spent energy.",
    "autonomous_on_interrupt": "Continue only if the skill explicitly has autonomous_after_commit=true.",
    "committed_status_on_caster_interrupt": "Already applied buffs/debuffs keep their stated lifetime. autonomous_after_commit governs released projectiles/zones/traps, not undoing a completed status application.",
    "owner_ko": "Remove owner persistent entities and unfinished effects after the current atomic resolution batch; finish already committed events in that batch.",
    "match_terminal_or_practice_reset": "Clear all pending effects, reserved costs, temporary statuses, projectiles and synthetic-owned entities exactly once.",
    "pause": "Freeze gameplay timers and preserve state. A disconnect notification itself does not grant a refund or cancel/restart a cast.",
    "historical_replay": "No fresh real clock, unseeded randomness, current mutable tuning, or browser animation callbacks."
  },
  "status_rules": {
    "same_named_buff": "Strongest magnitude wins; an accepted reapplication refreshes duration. No additive stacking.",
    "same_dot_family_on_target": "Strongest instance wins across sources. A weaker/equal reapplication may refresh duration but cannot increase tick damage or cause an immediate extra tick; keep the next scheduled tick. Retain winning damage attribution.",
    "dot_family_relationship": "BAGE_DECAY and VISIONARY_LOAD are distinct families and may coexist.",
    "slow": {
      "strongest_only": true,
      "minimum_remaining_movement_fraction": 0.4,
      "slows_affect_dash_distance": false
    },
    "healing": "Living self/allies only, same combat context; no resurrection, no overheal, no outsider assistance into an active duel.",
    "visionary_healing_allowed": false,
    "invisibility": "Breaks on taking damage or on the next non-movement ability commit; its own activation does not immediately break it. Manual/AoE hits still work; do not render an enemy target marker or keep automatic tracking after target loss.",
    "immunity": "Blocks incoming damage and new harmful statuses during its lifetime. Existing status timers continue; it does not cleanse. Movement/dash allowed, new offensive/support casts and guards blocked while active. Existing released effects may finish.",
    "discord": {
      "duration_seconds": 4,
      "friendly_damage_fraction": 0.5,
      "changes_team_identity": false,
      "forces_actions": false,
      "allows_self_damage": false,
      "changes_healing_targets": false,
      "out_of_match_allowed": false,
      "snapshot": "At each voluntary damage-action commit, record whether curse was active. It enables that action to hit original teammates, including its released effects. Preexisting effects are not retroactively converted.",
      "attribution": "Keep actual attacking actor and curse instigator separately; simultaneous marks do not stack."
    },
    "manifestations": {
      "modes": [
        "WORLD_FIXED",
        "FOLLOW_TARGET",
        "FOLLOW_CASTER",
        "PROJECTILE"
      ],
      "automatic_retarget": false,
      "target_lost": "End a following manifestation; a projectile continues its recorded heading until hit/expiry without acquiring another target.",
      "line_of_sight": "Validate initial targeting and use existing collisions/visibility; never bypass walls or become an instant hit through tracking.",
      "entity_cap": "At cap, reject a new persistent-offense placement without charge. Do not silently replace the oldest.",
      "visuals": "Visible cast/body/object/projectile motion and applied-status icons only; no added preattack warning banners, countdowns, danger outlines or aim-snapping prompts."
    }
  },
  "teams": {
    "owner_max_team_size": 3,
    "dev_equal_team_sizes": [
      1,
      2,
      3
    ],
    "spectators_are_combatants": false,
    "normal_friendly_fire": false,
    "healing_inside_matches": true,
    "healing_outside_matches": true,
    "outside_match_heal_targets_dev": "Self or explicit same-party/practice-team living ally who is also outside a match.",
    "win_policy_dev": "All opposing team members knocked out; no in-round respawn or resurrection in this packet.",
    "simultaneous_team_elimination": "Use an existing draw policy. If absent, implement an explicit no-winner/no-reward DRAW_DEV for this new ruleset only, distinct from disconnect NO_CONTEST.",
    "resolution": "Resolve same-timestamp committed damage/heal/self-KO events as an atomic authoritative batch, then evaluate victory.",
    "self_ko_resolution": "Self-KO is a committed cost, not ordinary mitigatable damage. It cannot be canceled by armor, immunity or healing in the same batch. Preserve existing deterministic event ordering for other effects; evaluate terminal outcome only after the batch.",
    "disconnect_extension_dev": "Any active combatant disconnect pauses the whole round. Track the original 10-elapsed-second deadline per disconnected combatant; duplicate notices never reset it. Earliest expiry ends the whole round NO_CONTEST. Resume only after every missing combatant returns before their deadline. Spectator loss does not pause.",
    "host_failure": "Preserve RECOVERY_HELD_DEV; no new host-failure outcome.",
    "pvp_flight": false
  },
  "scope": {
    "current": "Local empty mechanics field, five data-driven class fixtures, starter skills/effect families, same-context allied practice and up-to-3v3 development fixtures.",
    "no_rewards_or_real_profiles": true,
    "new_shipping_topology_decided": false,
    "new_map_or_matchmaking": false,
    "art_dependency": "Use stand-ins until an explicitly released export and manifest are available. Do not open/edit Astra work files.",
    "workouts": "No new MAHFITT sync; 3\u20135x proposal is skill XP only, not damage or character-level XP.",
    "existing_progression": "Preserve existing modifiers exactly once; neither class changes/resets nor slot milestones are settled here.",
    "movement_multiplier_scope": "Normal ground locomotion and free-flight cruise against their existing base speeds. Forced descent/landing keeps its existing safety controller. No PvP flight is enabled."
  },
