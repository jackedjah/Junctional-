    "dissipation": "A successful frontal magical guard destroys an explicitly dissipatable pure-magic projectile before damage/status application. No automatic dissipation of mixed body strikes, zones, or existing DoTs.",
    "already_applied_periodic_damage_blockable": false,
    "both_guards_simultaneously": false,
    "switch_during_committed_attack": "No; request is refused without changing the active attack.",
    "holding_guard_blocks_new_attack_start": true,
    "dash_releases_guard": true,
    "perfect_parry": "Preserve existing behavior; no new perfect-parry mechanic in this packet."
  },
  "input": {
    "category_selection": "Explicit PHYSICAL / PHYSICAL_MAGIC / SPECIAL_MAGIC tabs; never proximity-switched.",
